# Server-side only. Copy to .dev.vars for local development; never commit it.
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# Portable Cloudflare deployment: shared secret sent only by your trusted auth gateway.
# Existing ChatGPT identity headers must be set by that gateway, not by the browser.
AUTH_GATEWAY_SECRET=
